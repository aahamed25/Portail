{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<main style="max-width: 400px; margin: 3rem auto; font-family: sans-serif;">
    <h1>Connexion</h1>

    {% if error %}
        <p style="background:#f8d7da; padding:.75rem; border-radius:6px;">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </p>
    {% endif %}

    <form method="post">
        <p>
            <label for="username">Email</label><br>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus style="width:100%">
        </p>
        <p>
            <label for="password">Mot de passe</label><br>
            <input type="password" id="password" name="_password" required style="width:100%">
        </p>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit">Se connecter</button>
    </form>

    <p><a href="{{ path('app_register') }}">Créer un compte</a></p>
</main>
{% endblock %}
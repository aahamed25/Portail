{% extends 'app_base.html.twig' %}

{% block title %}Changer mon mot de passe{% endblock %}

{% block body %}
    <div class="card" style="max-width: 520px; margin: 0 auto;">
        <h2>Changer mon mot de passe</h2>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <p style="font-size:.8rem; color:#777;">
                12 caractères minimum avec majuscule, minuscule, chiffre et caractère spécial.
                Vous ne pouvez pas réutiliser un ancien mot de passe.
            </p>
            <p style="margin-top:1.2rem;">
                <button class="btn" type="submit">Enregistrer</button>
                <a class="btn btn-light" href="{{ path('app_profile') }}">Annuler</a>
            </p>
        {{ form_end(form) }}
    </div>
{% endblock %}